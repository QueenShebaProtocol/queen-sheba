# Queen Sheba Environment Configuration
# Demonstration and Vulnerable Target Settings

PORT=8000
HOST=127.0.0.1

# When true, the application runs entirely locally with realistic mock AI responses
# without consuming external API tokens or needing provider credentials.
DEMO_MOCK_MODE=true

# LLM Provider Configuration (used when DEMO_MOCK_MODE=false)
# Supported providers: gemini, openai
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_MAX_OUTPUT_TOKENS=350
LLM_TEMPERATURE=0.7

# Conversation History Limits (Token conservation)
MAX_HISTORY_MESSAGES=50

# --- AI Prompt Injection Firewall integration ---
# Set LLM_PROVIDER=openai, DEMO_MOCK_MODE=false and LLM_API_KEY to any non-empty value
# (the real provider key lives in the firewall's .env as TARGET_LLM_API_KEY).
# LLM_MODEL must be a model the firewall's downstream provider accepts.
# Leave FIREWALL_URL empty to keep the intentionally vulnerable, unprotected demo.
FIREWALL_URL=
# FIREWALL_URL=http://localhost:8000/v1
